---
import type { GetStaticPaths } from "astro";
import { ModelPage } from "@/components/pages/model-page";
import BaseLayout from "@/layouts/base-layout.astro";
import { getLanguageModels } from "@/lib/data";
import type { LanguageModel } from "@/lib/types";

export const getStaticPaths = (() => {
  const { data } = getLanguageModels();
  return data.map((model) => ({
    params: { model: model.id },
    props: { model, peers: data },
  }));
}) satisfies GetStaticPaths;

interface Props {
  model: LanguageModel;
  peers: LanguageModel[];
}

const { model, peers } = Astro.props;
---

<BaseLayout
  title={model.name}
  description={`${model.name}（${model.model_creator?.name ?? "未知"}）的智能指数、价格与性能评测详情。`}
>
  <ModelPage model={model} peers={peers} />
</BaseLayout>
