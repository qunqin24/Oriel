---
/**
 * 单个指标的历史轨迹。
 *
 * 目前只有 4 天历史，绝大多数模型的线是平的。平线不算错，但等于噪音——
 * 所以值没变过时直接写「N 天记录内无变化」，比画一条水平线信息量更大。
 * 版本换代造成的断段由 metricSeries 切好，这里各段各画，中间自然断开。
 */
import { MIN_TREND_POINTS, metricSeries, SNAPSHOT_DATES } from "@/lib/history";
import { fill, t, type Locale } from "@/i18n";
import type { MetricKey } from "@/lib/history-schema";

interface Props {
  modelId: string;
  metric: MetricKey;
  locale: Locale;
  label: string;
  /** 数值越低越好时，下降画成上涨色 */
  lowerIsBetter?: boolean;
  /**
   * 没有可画的历史时整块不渲染，而不是占一格「积累中」。
   * 新增的行业评测/评测成本指标用它——大多数模型只有部分有值，不该让详情页变长。
   */
  hideWhenEmpty?: boolean;
  format: (value: number) => string;
}

const {
  modelId,
  metric,
  locale,
  label,
  lowerIsBetter = false,
  hideWhenEmpty = false,
  format,
} = Astro.props;
const dict = t(locale);

const segments = metricSeries(modelId, metric);
const hasAnyPoint = segments.some((segment) => segment.length > 0);
const days = SNAPSHOT_DATES.length;

/**
 * 只画点数 ≥ MIN_TREND_POINTS 的段落：两个点能连成线但说明不了任何事。
 * 版本换代后新段落还短时，宁可明说「积累中」也不画一条两点的线。
 */
const drawn = segments.filter((segment) => segment.length >= MIN_TREND_POINTS);
const values = drawn.flat().map((point) => point.value);
const changed = new Set(values).size > 1;

const W = 168;
const H = 34;
const PAD = 3;

const min = values.length ? Math.min(...values) : 0;
const max = values.length ? Math.max(...values) : 1;
const span = max - min || 1;

const dateIndex = new Map(SNAPSHOT_DATES.map((date, index) => [date, index]));
const lastIndex = Math.max(SNAPSHOT_DATES.length - 1, 1);

const px = (date: string) =>
  PAD + ((dateIndex.get(date) ?? 0) / lastIndex) * (W - PAD * 2);
const py = (value: number) =>
  PAD + (1 - (value - min) / span) * (H - PAD * 2);

const paths = changed
  ? drawn.map((segment) =>
      segment
        .map(
          (point, index) =>
            `${index === 0 ? "M" : "L"}${px(point.date).toFixed(1)},${py(point.value).toFixed(1)}`
        )
        .join(" ")
    )
  : [];

// 首尾取最近一段：跨 index_version 的首尾值不可比。
const latest = drawn.at(-1) ?? [];
const first = latest[0]?.value ?? null;
const last = latest.at(-1)?.value ?? null;
const improved =
  first != null && last != null && first !== last
    ? lowerIsBetter
      ? last < first
      : last > first
    : null;

type State = "hidden" | "noData" | "thin" | "flat" | "chart";
const state: State = !hasAnyPoint
  ? hideWhenEmpty
    ? "hidden"
    : "noData"
  : days < MIN_TREND_POINTS || drawn.length === 0
    ? hideWhenEmpty
      ? "hidden"
      : "thin"
    : !changed
      ? hideWhenEmpty
        ? "hidden"
        : "flat"
      : "chart";
---

{state !== "hidden" && (
<div class="flex flex-col gap-1.5">
  <span class="eyebrow">{label}</span>

  {
    state === "noData" ? (
      <p class="text-[12px] text-mute">{dict.model.noData}</p>
    ) : state === "thin" ? (
      <p class="text-[12px] text-mute">{dict.model.trajectoryThin}</p>
    ) : state === "flat" ? (
      <p class="text-[12px] text-mute">
        {fill(dict.model.trajectoryFlat, { days })}
      </p>
    ) : (
      <div class="flex items-center gap-3">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          width={W}
          height={H}
          fill="none"
          role="img"
          aria-label={`${label}: ${format(first ?? 0)} → ${format(last ?? 0)}`}
          class="shrink-0"
        >
          {paths.map((d) => (
            <path
              d={d}
              stroke={
                improved === null
                  ? "var(--mute)"
                  : improved
                    ? "var(--rise)"
                    : "var(--fall)"
              }
              stroke-width="1.25"
              stroke-linejoin="round"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
            />
          ))}
          {latest.length > 0 && (
            <circle
              cx={px(latest.at(-1)!.date).toFixed(1)}
              cy={py(latest.at(-1)!.value).toFixed(1)}
              r="2"
              fill="var(--gold)"
            />
          )}
        </svg>
        <span class="data text-xs">
          <span class="text-mute">{format(first ?? 0)}</span>
          <span class="mx-1 text-mute">→</span>
          <span class="text-fg">{format(last ?? 0)}</span>
        </span>
      </div>
    )
  }
</div>
)}
