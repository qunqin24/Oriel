---
/**
 * 品牌标记：一扇凸窗，右侧那格透着光。
 *
 * Oriel 本义就是凸窗，金色是从窗里透出来的光——
 * 这是全站金色唯一的装饰性用法，其余地方它只用来指示前沿、第一名和当前快照。
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 16, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <rect x="8" y="2.5" width="5.5" height="11" fill="var(--gold)" opacity="0.22"></rect>
  <rect
    x="2.5"
    y="2.5"
    width="11"
    height="11"
    rx="0.5"
    stroke="var(--gold)"
    stroke-width="1.1"></rect>
  <path d="M8 2.5V13.5" stroke="var(--gold)" stroke-width="1.1"></path>
</svg>
