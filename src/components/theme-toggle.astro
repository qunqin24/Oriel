---
/**
 * 深浅切换。
 *
 * 监听器委托到 document 且只装一次，所以这个按钮可以在侧栏和顶栏同时出现
 * 而不会重复绑定。初始主题由 base.astro 的 head 内联脚本在首帧前设好。
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = "" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class:list={[
    "inline-flex h-7 w-7 items-center justify-center rounded-sm border border-rule text-mute transition-colors hover:border-mute hover:text-fg",
    className,
  ]}
>
  {/* 默认是简约白，所以默认显示太阳；深色时换成月亮 */}
  <svg
    width="13"
    height="13"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden dark:block"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg
    width="13"
    height="13"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="dark:hidden"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"
    ></path>
  </svg>
</button>
