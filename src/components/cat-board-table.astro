---
/**
 * 猫榜的通用表格渲染器：logic 与 vision 用这个。
 *
 * 单元格已经是源站格式化好的字符串（¥178.58、7.57%），不需要也不应该
 * 再解析成数字重新格式化——那等于对一份我们不了解全部规则的评分体系
 * 做二次加工。原样显示，只翻表头。
 *
 * 首列（模型名）不链接到 /models/[slug]：猫榜的模型命名和 Oriel 的
 * slug 体系是两套不相干的来源（比如"讯飞星火X1.5"根本不在 AA 数据里），
 * 强行猜链接只会产出错误跳转。
 */
import { headerLabel, isThinkHeader, isThinkOn } from "@/lib/cat-board";
import type { CatBoardCategory } from "@/lib/cat-board";
import { t, type Locale } from "@/i18n";

interface Props {
  category: CatBoardCategory;
  locale: Locale;
}

const { category, locale } = Astro.props;
const dict = t(locale);
---

<div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
  <table class="w-full min-w-[40rem] border-collapse text-sm">
    <thead>
      <tr class="border-b border-rule">
        {
          category.headers.map((header, index) => (
            <th
              scope="col"
              class={`py-2 whitespace-nowrap ${index === 0 ? "text-left pr-3" : "text-right pl-3"}`}
              title={isThinkHeader(header) ? dict.catBoard.thinkHint : undefined}
            >
              <span class="eyebrow">{headerLabel(header, locale)}</span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        category.rows.map((row, rowIndex) => (
          <tr class="border-b border-rule/50">
            {row.map((cell, colIndex) => {
              if (colIndex === 0) {
                return (
                  <td
                    class:list={[
                      "py-1.5 pr-3 text-left max-w-[16rem] truncate",
                      rowIndex === 0 ? "text-gold" : "text-fg",
                    ]}
                    title={cell}
                  >
                    {cell}
                  </td>
                );
              }
              const header = category.headers[colIndex] ?? "";
              if (isThinkHeader(header)) {
                const on = isThinkOn(cell);
                return (
                  <td
                    class="data py-1.5 pl-3 text-right whitespace-nowrap"
                    title={dict.catBoard.thinkHint}
                  >
                    <span class={on ? "text-fg" : "text-mute"}>
                      {on ? dict.catBoard.think.on : dict.catBoard.think.off}
                    </span>
                  </td>
                );
              }
              return (
                <td class="data py-1.5 pl-3 text-right whitespace-nowrap text-fg">
                  {cell || <span class="text-mute/50">—</span>}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
