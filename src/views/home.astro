---
import BaseLayout from "@/layouts/base.astro";
import FrontierPlot from "@/components/frontier-plot.astro";
import SectionHead from "@/components/section-head.astro";
import ChangeList from "@/components/change-list.astro";
import RankList from "@/components/rank-list.astro";
import type { RankRow } from "@/lib/types";
import { MEDIA_BOARDS, MEDIA_TOTAL, MODELS } from "@/lib/data";
import { eventsByDay } from "@/lib/history";
import { coverage } from "@/lib/metrics";
import { formatInteger, formatNumber } from "@/lib/format";
import { href, t, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const withIntelligence = coverage(MODELS, "intelligence");

const topTen: RankRow[] = MODELS.slice(0, 10).map((model) => ({
  name: model.name,
  creator: model.model_creator?.name ?? "",
  value: model.evaluations.artificial_analysis_intelligence_index,
  display: formatNumber(
    model.evaluations.artificial_analysis_intelligence_index,
    locale,
    1
  ),
  href: href(locale, `/models/${model.slug}`),
}));

// 首页只放最近三天，完整记录在 /changes。
const recentDays = eventsByDay(3);
---

<BaseLayout locale={locale} active="home" description={dict.site.description}>
  <div class="flex flex-col gap-14">
    {/* 前沿图就是首页的论点：一眼看完整个领域，而不是一句标语加两个按钮 */}
    <section class="flex flex-col gap-5">
      <header class="flex flex-col gap-2">
        <span class="eyebrow">{dict.site.name} · {dict.nav.home}</span>
        <h1 class="text-xl font-semibold tracking-tight text-fg sm:text-2xl">
          {dict.home.frontierTitle}
        </h1>
        <p class="max-w-2xl text-sm leading-relaxed text-mute">
          {dict.site.description}
        </p>
      </header>

      <FrontierPlot locale={locale} />
    </section>

    <section>
      <SectionHead
        title={dict.home.recentChanges}
        href={href(locale, "/changes")}
        linkLabel={dict.home.allChanges}
      />
      <ChangeList days={recentDays} locale={locale} />
    </section>

    <section>
      <SectionHead
        title={dict.home.topBoard}
        note={`${formatInteger(withIntelligence, locale)} ${dict.models.coverage}`}
        href={href(locale, "/models")}
        linkLabel={dict.home.fullBoard}
      />
      <RankList rows={topTen} locale={locale} />
    </section>

    <section>
      <SectionHead
        title={dict.home.mediaTitle}
        note={`${formatInteger(MEDIA_TOTAL, locale)} ${dict.common.models}`}
        href={href(locale, "/media")}
        linkLabel={dict.home.viewAll}
      />
      <ul class="grid gap-x-8 gap-y-0 sm:grid-cols-2">
        {
          MEDIA_BOARDS.map((board) => {
            const leader = board.rows[0];
            return (
              <li class="flex items-baseline gap-3 border-b border-rule/60 py-2 text-sm">
                <a
                  href={`${href(locale, "/media")}#${board.id}`}
                  class="w-28 shrink-0 text-fg transition-colors hover:text-gold"
                >
                  {board.label(dict)}
                </a>
                <span class="min-w-0 flex-1 truncate text-mute" title={leader?.name}>
                  {leader?.name ?? dict.common.noValue}
                </span>
                <span class="data shrink-0 text-[12px] text-mute">
                  {board.rows.length}
                </span>
              </li>
            );
          })
        }
      </ul>
      <p class="mt-3 text-[12px] text-mute">{dict.home.mediaNote}</p>
    </section>
  </div>
</BaseLayout>
